{
  "name": "@agentkernel/sdk",
  "version": "1.0.0",
  "description": "Typed TypeScript client for the AgentKernel Execution Protocol HTTP API",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist/src", "README.md"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/test/*.test.js\""
  },
  "engines": { "node": ">=18" },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.0"
  }
}
